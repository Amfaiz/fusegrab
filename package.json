{
    "name": "fusegrab",
    "version": "1.5.0",
    "private": true,
    "description": "FuseGrab — download YouTube videos.",
    "author": "Amfaiz",
    "type": "module",
    "main": ".vite/build/main.js",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "postinstall": "node scripts/postinstall-electron.mjs",
        "start": "electron-forge start",
        "dev": "electron-forge start",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "make:mac": "node scripts/build-installers.mjs mac",
        "make:win-arm": "node scripts/build-installers.mjs win-arm",
        "make:win-x64": "node scripts/build-installers.mjs win-x64",
        "make:all": "node scripts/build-installers.mjs all",
        "make:nsis": "pnpm run package && node scripts/make-nsis.mjs",
        "publish": "node scripts/publish-release.mjs",
        "notes": "node scripts/generate-release-notes.mjs",
        "release": "pnpm run make:nsis && node scripts/publish-release.mjs",
        "generate-icons": "node scripts/generate-icons.mjs",
        "test": "vitest run --passWithNoTests",
        "lint": "eslint",
        "format": "prettier --write . && eslint --fix",
        "check": "prettier --check ."
    },
    "dependencies": {
        "@base-ui-components/react": "1.0.0-rc.0",
        "@base-ui/react": "^1.6.0",
        "@distube/ytdl-core": "^4.16.12",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@fontsource-variable/inter": "^5.2.8",
        "@hugeicons/core-free-icons": "^4.1.4",
        "@hugeicons/react": "^1.1.6",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-query": "^5.101.0",
        "@tanstack/react-router": "^1.132.0",
        "@types/electron-squirrel-startup": "^1.0.2",
        "clsx": "^2.1.1",
        "electron-squirrel-startup": "^1.0.1",
        "ffmpeg-static": "^5.3.0",
        "play-dl": "^1.9.7",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.1.18",
        "yt-dlp-wrap": "^2.3.12"
    },
    "devDependencies": {
        "@electron-forge/cli": "^7.6.0",
        "@electron-forge/maker-dmg": "^7.11.2",
        "@electron-forge/maker-squirrel": "^7.6.0",
        "@electron-forge/maker-zip": "^7.6.0",
        "@electron-forge/plugin-fuses": "^7.6.0",
        "@electron-forge/plugin-vite": "^7.6.0",
        "@tailwindcss/typography": "^0.5.16",
        "@tanstack/eslint-config": "latest",
        "@tanstack/router-plugin": "^1.168.10",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^22.10.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "electron": "^33.0.2",
        "eslint": "^9.20.0",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "jsdom": "^28.1.0",
        "png2icons": "^2.0.1",
        "pngjs": "^7.0.0",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "typescript": "^6.0.2",
        "vite": "^8.0.0",
        "vitest": "^4.1.5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "lightningcss",
            "electron",
            "electron-winstaller",
            "unrs-resolver",
            "fs-xattr",
            "macos-alias"
        ]
    }
}
